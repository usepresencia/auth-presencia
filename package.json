{
    "name": "@presencia/auth-service",
    "version": "0.1.0",
    "private": true,
    "description": "Serviço central de identidade e autenticação da Presencia",
    "license": "UNLICENSED",
    "engines": {
        "node": "^24.15.0"
    },
    "scripts": {
        "start": "node dist/main.js",
        "start:dev": "nest start --watch",
        "build": "prisma generate && nest build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test scripts poc",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "docs": "typedoc",
        "docs:watch": "typedoc --watch",
        "commit": "cz",
        "release": "standard-version",
        "prepare": "node scripts/prepare.mjs",
        "test:integration": "node --test test/integration/*.spec.mjs",
        "db:migrate": "prisma migrate deploy",
        "test:poc": "node --test poc/oidc-provider.spec.mjs",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "emulators": "firebase emulators:start --only auth --project demo-presencia"
    },
    "dependencies": {
        "@nestjs/common": "^12.3.2",
        "@nestjs/config": "^12.0.1",
        "@nestjs/core": "^12.3.2",
        "@nestjs/platform-express": "^12.3.2",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "firebase-admin": "^14.5.1",
        "oidc-provider": "^9.15.1",
        "pg": "^8.23.1",
        "prisma": "^7.10.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.1.0",
        "@commitlint/config-conventional": "^20.0.0",
        "@eslint/js": "^10.0.1",
        "@nestjs/cli": "^12.0.11",
        "@nestjs/testing": "^12.3.2",
        "@types/node": "^24.0.0",
        "@types/oidc-provider": "^9.15.0",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^6.0.3",
        "@vitest/coverage-v8": "^4.1.12",
        "commitizen": "^4.3.1",
        "cz-conventional-changelog": "^3.3.0",
        "eslint": "^10.14.0",
        "firebase-tools": "^15.37.0",
        "globals": "^16.0.0",
        "husky": "^9.1.7",
        "jose": "^6.2.18",
        "lint-staged": "^16.2.6",
        "prettier": "^3.6.2",
        "standard-version": "^9.5.0",
        "supertest": "^7.1.0",
        "typedoc": "^0.28.17",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.72.1",
        "vitest": "^4.1.3"
    },
    "lint-staged": {
        "**/*.{css,scss,yaml,yml,ts,js,mjs,cjs,jsx,tsx,json,md}": "prettier --write"
    },
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
