NODE_ENV=development
HOST=127.0.0.1
PORT=3340
# Origem pública do auth. Em dev com o front, use a origem do front (proxy).
AUTH_ISSUER=http://localhost:3340

# PostgreSQL dedicado ao auth. Suba com docker compose up -d db e aplique npm run db:migrate.
DATABASE_URL=postgresql://auth:change-me@127.0.0.1:55433/presencia_auth

# Gere com: node scripts/generate-keys.mjs
AUTH_JWKS=
AUTH_COOKIE_KEYS=

# Preencha clientSecret com um valor gerado (mínimo de 32 caracteres).
AUTH_CLIENTS='[{"clientId":"web-kontal","clientSecret":"","redirectUris":["http://localhost:3341/callback"],"postLogoutRedirectUris":["http://localhost:3341"],"resource":"urn:presencia:api-kontal","audience":"api-kontal","scope":"api","firebaseClaims":["platformRole","kontalMemberships"]}]'
# true apenas atrás de proxy confiável.
AUTH_TRUST_PROXY=false

# Desenvolvimento usa o Firebase Auth Emulator; remova a última linha em produção.
FIREBASE_PROJECT_ID=demo-presencia
FIREBASE_API_KEY=fake-api-key
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Opcionais fora do emulador; sem eles vale a credencial padrão da aplicação.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
